# Copy to .env for local development. Stripe Projects manages provider credentials.
TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN is not required for local file databases.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MOCK=1
# Keep the Ideogram API key server-side; never expose it with a PUBLIC_ prefix.
IDEOGRAM_API_KEY=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
NETLIFY_BUILD_HOOK_URL=
SITE_URL=http://localhost:8888
SITE_NAME=Voice-narrated blog
SITE_AUTHOR=Blog author
SITE_DESCRIPTION=Long-form writing, to read or listen.
SITE_ACCENT=#8a4c33
